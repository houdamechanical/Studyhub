      "css": ".ds-rail{display:flex;flex-direction:column;gap:4px;padding:12px;width:64px;background:#f7f8fb;border-right:1px solid #e3e7f0}.ds-rail a{position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:8px;color:#545f75;cursor:pointer;transition:background .2s,color .2s,transform .2s}.ds-rail a:hover{background:rgb(243 245 250/.7);color:#0f1729}.ds-rail a:active{transform:scale(.985)}.ds-rail a.on{background:#f3f5fa;color:#2350d8}.ds-rail a.on::before{content:'';position:absolute;left:-12px;top:10px;bottom:10px;width:3px;border-radius:3px;background:#2350d8}"
