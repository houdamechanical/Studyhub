  "narrative": {
    "northStar": "The Class Planner",
    "overview": "Study Hub is the planner a well-organised student keeps for the whole school year: cream paper, a red pen for what matters, ink blue for notes, and a shelf of coloured subject books. Everything has its place – the next exam on top, every subject in its own book, every grade in its row – so a student between lessons finds what they need in one tap. Order comes first; personality lives in the details you touch.\n\nComponents are tactile and friendly. Surfaces sit on the paper with soft shadows, buttons give a small press, and the subject books are real objects: they tilt toward the pointer, catch the light and grow to fill the screen when opened. Study content switches to a printed-page serif with margin line numbers, so a Musterlösung looks like the worksheet it came from.\n\nLight mode is paper on a desk; dark mode is the same planner at night (warm brown-black, chalk text, coral instead of red). Both are first-class; the user picks Light, Dark or System.",
    "keyCharacteristics": [
      "Cream paper, red pen, ink blue – one strong accent, one quiet second colour.",
      "Every subject has a fixed book colour and icon; colour signals the subject, not decoration.",
      "Soft shadows lift cards gently off the page; pop-ups and books lift further.",
      "Large, readable text (18px base) with a friendly grotesque for headings.",
      "Study pages read like printed school material (serif, verse/line numbers, Fachbegriffe in bold)."
    ],
    "rules": [
      {
        "name": "The Red Pen Rule",
        "body": "Correction Red marks what to do or look at next – one primary button, the active tab, the countdown. If everything is red, nothing is.",
        "section": "colors"
      },
      {
        "name": "The Book Colour Rule",
        "body": "Subject colours belong to subjects. Never use a book colour as a general accent, background or decoration.",
        "section": "colors"
      },
      {
        "name": "The Two Modes Rule",
        "body": "Every colour ships as a light and a dark pair; text pairs must pass WCAG AA (4.5:1) in both.",
        "section": "colors"
      },
      {
        "name": "The Big-Enough Rule",
        "body": "Nothing a student must read is smaller than 0.875rem; fixed pixel sizes below 14px are not allowed.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Grades, points, NC, timers and countdowns use tabular figures so digits don't jump.",
        "section": "typography"
      },
      {
        "name": "The Gentle Lift Rule",
        "body": "Shadows are soft and warm, never hard black edges. The more a thing can be picked up (dialog, book), the higher it floats.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep one Correction Red action per view; everything else is outline or ghost.",
      "Do use the subject's book colour whenever a subject is shown (book, badge, grade card) – and only then.",
      "Do ship every screen in light and dark and check text contrast ≥ 4.5:1 in both.",
      "Do keep reading text at 18px root and labels ≥ 0.875rem; use tabular numbers for grades and dates.",
      "Do give tappable things press feedback (scale 0.985) and a 44px touch target.",
      "Do respect prefers-reduced-motion (no tilt, zoom or slide)."
    ],
    "donts": [
      "Don't use book colours as decoration, backgrounds or gradients outside subject contexts.",
      "Don't add hard, dark, offset shadows or glowing neon effects.",
      "Don't shrink text below 14px or use thin weights for anything students must read.",
      "Don't let pages scroll sideways on a phone; scroll wide tables and formulas inside their box.",
      "Don't introduce a third accent colour; Ink Blue and Check Green stay small and functional."
    ]
  }
}
